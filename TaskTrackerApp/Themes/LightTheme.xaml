<!-- Light colour tokens (Windows 11 Fluent neutral ramp). Colours only: control styles live in Controls.xaml.
     Translucent layers let the Mica backdrop show through on Windows 11; on Windows 10 they sit on WindowBackground.
     Accent brushes here are fallbacks: Theming/AccentService replaces them with the Windows accent colour. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="po">
    <sys:Boolean x:Key="IsDarkTheme">False</sys:Boolean>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F3F3F3" po:Freeze="True"/>
    <SolidColorBrush x:Key="LayerBackground" Color="#80FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#80FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardBackground" Color="#B3FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardHover" Color="#F2FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardStroke" Color="#12000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="SolidCardBackground" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="FlyoutBackground" Color="#F9F9F9" po:Freeze="True"/>

    <!-- Controls -->
    <SolidColorBrush x:Key="ControlBackground" Color="#B3FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ControlHover" Color="#0D000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="ControlPressed" Color="#06000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="ControlSelected" Color="#12000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="SubtleFill" Color="#09000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="InputFocusedBackground" Color="#FFFFFF" po:Freeze="True"/>

    <!-- Strokes -->
    <SolidColorBrush x:Key="BorderBrush" Color="#24000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="BorderLight" Color="#14000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="BorderMedium" Color="#38000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="DividerStroke" Color="#14000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="InputBottomStroke" Color="#72000000" po:Freeze="True"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#E4000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextHighlight" Color="#CC000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#A8000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextMuted" Color="#8F000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextDark" Color="#8A000000" po:Freeze="True"/>

    <!-- Accent (fallback; overridden by AccentService) -->
    <SolidColorBrush x:Key="PrimaryBackground" Color="#4F46E5" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#6366F1" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryColor" Color="#4F46E5" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentText" Color="#4338CA" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ActiveRowBackground" Color="#144F46E5" po:Freeze="True"/>

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessColor" Color="#0F7B0F" po:Freeze="True"/>
    <SolidColorBrush x:Key="SuccessBackground" Color="#260F7B0F" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarningColor" Color="#9D5D00" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarningBackground" Color="#33F7C04A" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerColor" Color="#C42B1C" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerBackground" Color="#1AC42B1C" po:Freeze="True"/>

    <SolidColorBrush x:Key="OverlayBackground" Color="#66000000" po:Freeze="True"/>

    <!-- Geometry -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
</ResourceDictionary>
