<!-- Dark colour tokens (Windows 11 Fluent neutral ramp). Colours only: control styles live in Controls.xaml.
     Translucent layers let the Mica backdrop show through on Windows 11; on Windows 10 they sit on WindowBackground.
     Accent brushes here are fallbacks: Theming/AccentService replaces them with the Windows accent colour. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="po">
    <sys:Boolean x:Key="IsDarkTheme">True</sys:Boolean>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackground" Color="#202020" po:Freeze="True"/>
    <SolidColorBrush x:Key="LayerBackground" Color="#4C3A3A3A" po:Freeze="True"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#4C3A3A3A" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardBackground" Color="#0DFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardHover" Color="#15FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardStroke" Color="#1AFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="SolidCardBackground" Color="#2B2B2B" po:Freeze="True"/>
    <SolidColorBrush x:Key="FlyoutBackground" Color="#2C2C2C" po:Freeze="True"/>

    <!-- Controls -->
    <SolidColorBrush x:Key="ControlBackground" Color="#0FFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ControlHover" Color="#15FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ControlPressed" Color="#08FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ControlSelected" Color="#19FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="SubtleFill" Color="#0FFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="InputFocusedBackground" Color="#B31E1E1E" po:Freeze="True"/>

    <!-- Strokes -->
    <SolidColorBrush x:Key="BorderBrush" Color="#1FFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="BorderLight" Color="#14FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="BorderMedium" Color="#33FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="DividerStroke" Color="#15FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="InputBottomStroke" Color="#8BFFFFFF" po:Freeze="True"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextHighlight" Color="#E6FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#C5FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextMuted" Color="#A6FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextDark" Color="#8BFFFFFF" po:Freeze="True"/>

    <!-- Accent (fallback; overridden by AccentService) -->
    <SolidColorBrush x:Key="PrimaryBackground" Color="#A5A7FA" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#B8BAFB" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryColor" Color="#A5A7FA" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentText" Color="#B8BAFB" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="ActiveRowBackground" Color="#1FA5A7FA" po:Freeze="True"/>

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessColor" Color="#6CCB5F" po:Freeze="True"/>
    <SolidColorBrush x:Key="SuccessBackground" Color="#2E6CCB5F" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarningColor" Color="#FFB900" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarningBackground" Color="#2EFFB900" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerColor" Color="#FF99A4" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerBackground" Color="#26FF99A4" po:Freeze="True"/>

    <SolidColorBrush x:Key="OverlayBackground" Color="#B3000000" po:Freeze="True"/>

    <!-- Geometry -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
</ResourceDictionary>
