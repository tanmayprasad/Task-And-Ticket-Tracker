<!-- A small themed message box: title, message and up to three buttons (see ChoiceDialog.Show). -->
<Window x:Class="TaskTrackerApp.Dialogs.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task And Ticket Tracker" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="24,20,24,24">
            <TextBlock x:Name="HeadingText" Style="{StaticResource SubtitleText}" TextWrapping="Wrap"/>
            <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" Margin="0,12,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="0,1,0,0" Padding="24,16">
            <UniformGrid x:Name="ButtonRow" Rows="1" HorizontalAlignment="Stretch"/>
        </Border>
    </Grid>
</Window>
