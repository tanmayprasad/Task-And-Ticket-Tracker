<!-- Asks for a short text such as a profile name (see TextPromptDialog.Show). -->
<Window x:Class="TaskTrackerApp.Dialogs.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task And Ticket Tracker" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="24,20,24,24">
            <TextBlock x:Name="HeadingText" Style="{StaticResource SubtitleText}"/>
            <TextBlock x:Name="PromptText" Style="{StaticResource BodyText}" Margin="0,8,0,12"/>
            <TextBox x:Name="InputBox" FontSize="14" AutomationProperties.Name="Name"/>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerColor}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="0,1,0,0" Padding="24,16">
            <UniformGrid Rows="1">
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0,0,4,0" Click="Ok_Click"/>
                <Button Content="Cancel" Style="{StaticResource StandardButton}" IsCancel="True" Margin="4,0,0,0"/>
            </UniformGrid>
        </Border>
    </Grid>
</Window>
