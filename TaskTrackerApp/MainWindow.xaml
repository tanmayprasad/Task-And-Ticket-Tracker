<Window x:Class="TaskTrackerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:TaskTrackerApp"
        Title="Task And Ticket Tracker - Manager" Height="700" Width="1000"
        StateChanged="Window_StateChanged"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextSecondary}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" Icon="pack://application:,,,/app.ico"
        MinWidth="720" MinHeight="480" SizeChanged="Window_SizeChanged">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <!-- Control styles live in Themes/Controls.xaml (shared by every window); only converters are local. -->
        <local:LessThanConverter x:Key="LessThanConverter"/>
        <local:NearLimitVisibilityConverter x:Key="NearLimitVis"/>
        <local:DueTextConverter x:Key="DueTextConverter"/>
        <local:DueUrgencyConverter x:Key="DueUrgencyConverter"/>
        <local:StepProgressConverter x:Key="StepProgressConverter"/>
        <local:StringToVisibilityConverter x:Key="StringToVis"/>
    </Window.Resources>
    
    <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <tb:TaskbarIcon x:Name="MyNotifyIcon"
                        ToolTipText="Task And Ticket Tracker"
                        IconSource="pack://application:,,,/app.ico"
                        TrayMouseDoubleClick="MyNotifyIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show Manager" Click="MenuItemShow_Click"/>
                    <MenuItem Header="Reset Widget Position" Click="MenuItemCenterWidget_Click"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="MenuItemExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Title bar (Mica shows through). Double-click maximizes; the maximize button supports Snap Layouts. -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="pack://application:,,,/app.ico" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Task And Ticket Tracker" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Left of the caption buttons. With Mica, Windows draws the native caption buttons, so this
                     gets a right margin in code (TitleBarActions) and the custom buttons below are hidden. -->
                <Button x:Name="ThemeToggleButton" Style="{StaticResource IconButton}" Height="32" Margin="0,4,8,0" Click="ThemeToggle_Click"
                        ToolTip="Switch between dark and light theme" AutomationProperties.Name="Toggle theme" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock x:Name="ThemeIconTextBlock" Text="&#xE706;" FontSize="14"/>
                </Button>
                <StackPanel x:Name="CaptionButtonsPanel" Orientation="Horizontal">
                <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize to the desktop widget" AutomationProperties.Name="Minimize"/>
                <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="MaximizeRestore_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize"/>
                <Button Content="&#xE8BB;" Style="{StaticResource CaptionCloseButton}" Click="Close_Click" ToolTip="Hide to tray (double-click the tray icon to reopen; Exit from its menu)" AutomationProperties.Name="Close to tray"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Navigation pane + content layer -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumnDef" Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation pane (Windows 11 NavigationView style) -->
            <Grid x:Name="SidebarColumn" Grid.Column="0" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <Button Content="&#xE700;" Style="{StaticResource IconButton}" Width="40" Height="36" HorizontalAlignment="Left" Margin="4,0,0,4"
                            Click="ToggleSidebar_Click" ToolTip="Expand or collapse the navigation pane" AutomationProperties.Name="Toggle sidebar"/>
                    <RadioButton x:Name="NavTasks" Style="{StaticResource NavItem}" IsChecked="True" Checked="Nav_Changed" ToolTip="Tasks" AutomationProperties.Name="Tasks">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Tasks" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,0,8">
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Checked="Nav_Changed" ToolTip="About" AutomationProperties.Name="About">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="20" VerticalAlignment="Center"/>
                            <TextBlock Text="About" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Checked="Nav_Changed" ToolTip="Settings" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="20" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>

            <!-- Content layer: rounded top-left corner like Windows 11 apps -->
            <Border x:Name="ContentLayer" Grid.Column="1" Background="{DynamicResource LayerBackground}" BorderBrush="{DynamicResource CardStroke}"
                    BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <Grid>
                <!-- Task Manager Tab -->
                <Grid x:Name="TasksTabContent" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TaskListColumn" Width="*"/>
                        <ColumnDefinition x:Name="TasksDividerColumn" Width="Auto"/>
                        <ColumnDefinition x:Name="TaskDetailsColumn" Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Task List -->
                    <Border Grid.Row="0" Grid.Column="0" Background="Transparent">
                        <Grid Margin="20,10,20,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Tasks" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="NewTaskButton_Click" ToolTip="New task (Ctrl+N)" AutomationProperties.Name="New task">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="New task" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                
                <!-- Quick add: type a title and press Enter -->
                <Border Grid.Row="1" Margin="0,0,0,12" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox x:Name="QuickAddTextBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="6,0" MinHeight="44" MaxLength="120"
                                 PreviewKeyDown="QuickAddTextBox_PreviewKeyDown" AutomationProperties.Name="Quick add task"
                                 ToolTip="Enter: add to the list · Ctrl+Enter: open the full form · Start with #123 or AB-12 to set the ticket number"/>
                        <TextBlock Grid.Column="1" Text="Add a task  (e.g. #123 Fix login)" FontSize="14" Foreground="{DynamicResource AccentText}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="9,0,8,0" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=QuickAddTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Filters -->
                <Grid Grid.Row="2" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FilterVstsTextBox" Grid.Column="0" TextChanged="Filter_Changed" Padding="5" FontSize="13" Foreground="{DynamicResource TextPrimary}" AutomationProperties.Name="Search tasks" ToolTip="Search by ticket number or title (Ctrl+F)"/>
                    <TextBlock Grid.Column="0" Text="Search ticket or title…" FontSize="13" Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0" x:Name="FilterPlaceholder"/>
                    
                    <ToggleButton x:Name="FilterStateToggle" Grid.Column="2" Padding="10,5" Style="{StaticResource ModernButton}" VerticalAlignment="Center" ToolTip="Filter by state" AutomationProperties.Name="Filter by state">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="States" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="8,1,0,0"/>
                        </StackPanel>
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsChecked, ElementName=FilterStateToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=FilterStateToggle}">
                        <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="5" CornerRadius="6">
                            <StackPanel>
                                <CheckBox x:Name="FilterStateToDo" IsChecked="True" Click="Filter_Changed" Margin="2,4">
                                    <Border CornerRadius="12" Padding="8,4" Background="{DynamicResource ControlHover}" HorizontalAlignment="Left" MinWidth="80">
                                        <TextBlock Text="To Do" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </Border>
                                </CheckBox>
                                <CheckBox x:Name="FilterStateInProgress" IsChecked="True" Click="Filter_Changed" Margin="2,4">
                                    <Border CornerRadius="12" Padding="8,4" Background="{DynamicResource WarningBackground}" HorizontalAlignment="Left" MinWidth="80">
                                        <TextBlock Text="In progress" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarningColor}" HorizontalAlignment="Center"/>
                                    </Border>
                                </CheckBox>
                                <CheckBox x:Name="FilterStateDone" IsChecked="False" Click="Filter_Changed" Margin="2,4">
                                    <Border CornerRadius="12" Padding="8,4" Background="{DynamicResource SuccessBackground}" HorizontalAlignment="Left" MinWidth="80">
                                        <TextBlock Text="Done" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessColor}" HorizontalAlignment="Center"/>
                                    </Border>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </Popup>
                    
                    <CheckBox x:Name="FilterActiveCheckBox" Grid.Column="4" Content="Active only" FontSize="13" Foreground="{DynamicResource TextHighlight}" VerticalAlignment="Center" Click="Filter_Changed" ToolTip="Show only the tasks you are focusing on"/>
                </Grid>
                
                <DataGrid x:Name="TasksDataGrid" Grid.Row="3" AutoGenerateColumns="False" SelectionChanged="TasksDataGrid_SelectionChanged" IsReadOnly="True" 
                          AllowDrop="True" Drop="TasksDataGrid_Drop" PreviewMouseLeftButtonDown="TasksDataGrid_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="TasksDataGrid_PreviewMouseLeftButtonUp" MouseMove="TasksDataGrid_MouseMove"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" SizeChanged="TasksDataGrid_SizeChanged">
                    <DataGrid.Columns>
                        <!-- 1. Priority rank; a drag grip appears on hover -->
                        <DataGridTemplateColumn Width="40" IsReadOnly="True" CanUserResize="False">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" Cursor="SizeAll" ToolTip="Priority — drag the card to reorder">
                                        <TextBlock x:Name="RankText" Text="{Binding Priority}" Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="GripText" Text="&#xE76F;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource TextSecondary}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                            <Setter TargetName="RankText" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="GripText" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 2. Title + chips (ticket, due date, steps) -->
                        <DataGridTemplateColumn x:Name="TitleColumn" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="0,9" ToolTip="{Binding Title}" ToolTipService.InitialShowDelay="400">
                                        <TextBlock x:Name="TitleText" Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel x:Name="MetaLine" Orientation="Horizontal" Margin="0,5,0,0">
                                            <Border Style="{StaticResource Chip}" Visibility="{Binding VstsNumber, Converter={StaticResource StringToVis}}">
                                                <TextBlock Text="{Binding VstsNumber, StringFormat=#{0}}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                            </Border>
                                            <Border x:Name="DueChip" Style="{StaticResource Chip}" Visibility="{Binding Text, ElementName=DueText, Converter={StaticResource StringToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="DueIcon" Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock x:Name="DueText" Text="{Binding Converter={StaticResource DueTextConverter}}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Visibility="{Binding Text, ElementName=StepsText, Converter={StaticResource StringToVis}}" ToolTip="Steps done">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE73A;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock x:Name="StepsText" Text="{Binding Converter={StaticResource StepProgressConverter}}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Converter={StaticResource DueUrgencyConverter}}" Value="Overdue">
                                            <Setter TargetName="DueChip" Property="Background" Value="{DynamicResource DangerBackground}"/>
                                            <Setter TargetName="DueText" Property="Foreground" Value="{DynamicResource DangerColor}"/>
                                            <Setter TargetName="DueIcon" Property="Foreground" Value="{DynamicResource DangerColor}"/>
                                            <Setter TargetName="DueText" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Converter={StaticResource DueUrgencyConverter}}" Value="Today">
                                            <Setter TargetName="DueChip" Property="Background" Value="{DynamicResource WarningBackground}"/>
                                            <Setter TargetName="DueText" Property="Foreground" Value="{DynamicResource WarningColor}"/>
                                            <Setter TargetName="DueIcon" Property="Foreground" Value="{DynamicResource WarningColor}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                            <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                            <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 3. State pill (a coloured dot when the list is narrow) -->
                        <DataGridTemplateColumn x:Name="StateColumn" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="StateBadge" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding State}">
                                        <TextBlock x:Name="StateText" Text="{Binding State}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="To Do">
                                            <Setter TargetName="StateBadge" Property="Background" Value="{DynamicResource SubtleFill}"/>
                                            <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="In progress">
                                            <Setter TargetName="StateBadge" Property="Background" Value="{DynamicResource WarningBackground}"/>
                                            <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource WarningColor}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                            <Setter TargetName="StateBadge" Property="Background" Value="{DynamicResource SuccessBackground}"/>
                                            <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource SuccessColor}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=Column.ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=60}" Value="True">
                                            <Setter TargetName="StateText" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="StateBadge" Property="Padding" Value="0"/>
                                            <Setter TargetName="StateBadge" Property="Width" Value="10"/>
                                            <Setter TargetName="StateBadge" Property="Height" Value="10"/>
                                            <Setter TargetName="StateBadge" Property="CornerRadius" Value="5"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=Column.ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=60}" Value="True"/>
                                                <Condition Binding="{Binding State}" Value="In progress"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="StateBadge" Property="Background" Value="{DynamicResource WarningColor}"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=Column.ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=60}" Value="True"/>
                                                <Condition Binding="{Binding State}" Value="Done"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="StateBadge" Property="Background" Value="{DynamicResource SuccessColor}"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=Column.ActualWidth, Converter={StaticResource LessThanConverter}, ConverterParameter=60}" Value="True"/>
                                                <Condition Binding="{Binding State}" Value="To Do"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="StateBadge" Property="Background" Value="{DynamicResource TextMuted}"/>
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 4. Active (focus) as a star -->
                        <DataGridTemplateColumn Width="52">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Padding" Value="4,0,12,0"/>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource StarToggle}" IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Click="ActiveCheckBox_Clicked" PreviewMouseLeftButtonDown="ActiveCheckBox_PreviewMouseLeftButtonDown"
                                              ToolTip="Focus on this task (shows it on the widget)" AutomationProperties.Name="Active"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state (no tasks, or nothing matches the filters) -->
                <StackPanel x:Name="EmptyStatePanel" Grid.Row="3" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,90,20,0">
                    <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource IconFont}" FontSize="48" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock x:Name="EmptyStateTitle" Text="No tasks yet" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyStateHint" Text="Create a task to get started." Style="{StaticResource BodyText}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="300" Margin="0,8,0,18"/>
                    <Button x:Name="EmptyStateButton" Content="Create your first task" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="EmptyStateButton_Click"/>
                </StackPanel>
            </Grid>
            </Border>

            <!-- Divider -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="1" Background="{DynamicResource DividerStroke}" Visibility="{Binding Visibility, ElementName=DetailsPanel}"/>

            <!-- Task Details Form -->
            <Grid x:Name="TaskDetailsGrid" Grid.Row="0" Grid.Column="2" Margin="30,10,30,20" Width="350" Visibility="{Binding Visibility, ElementName=DetailsPanel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Grid x:Name="DetailsPanel" Visibility="Collapsed" Grid.Row="0" Margin="0,0,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/> <!-- Content -->
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,20,25">
                        <TextBlock x:Name="DetailsHeaderText" Text="Task details" Style="{StaticResource SubtitleText}" VerticalAlignment="Center"/>
                        <Button x:Name="MaximizeDetailsButton" Content="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" HorizontalAlignment="Right" Click="ToggleMaximize_Click" Cursor="Hand" ToolTip="Expand details" AutomationProperties.Name="Expand or restore details" FontSize="14" Padding="5"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Padding="0,0,20,0">
                        <Grid x:Name="DetailsFormGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="DetailsRightColumn" Width="0"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel x:Name="ContentStack" Grid.Column="0" Margin="0">
                                <!-- 1. Title -->
                                <StackPanel x:Name="TitleSection">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Title *" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left" x:Name="TitleLabel"/>
                                        <TextBlock Text="{Binding ElementName=TitleTextBox, Path=Text.Length, StringFormat={}{0}/100}" Visibility="{Binding ElementName=TitleTextBox, Path=Text.Length, Converter={StaticResource NearLimitVis}, ConverterParameter=100}" Foreground="{DynamicResource TextMuted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <TextBox x:Name="TitleTextBox" Margin="0,0,0,5" MaxLength="100" FontSize="14" AutomationProperties.Name="Title"/>
                                    <TextBlock x:Name="TitleErrorText" Text="Title is a mandatory field." Foreground="{DynamicResource DangerColor}" FontSize="12" Margin="0,0,0,5" Visibility="Collapsed"/>
                                </StackPanel>

                                <!-- 2. Steps (what the widget shows) -->
                                <StackPanel x:Name="StepsSection" Margin="0,16,0,0">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Steps" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="StepsProgressText" Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewStepTextBox" Grid.Column="0" Margin="0,0,8,0" KeyDown="NewStepTextBox_KeyDown" MaxLength="100" AutomationProperties.Name="New step"
                                                 ToolTip="Press Enter to add. Paste a list to add one step per line."/>
                                        <TextBlock Text="Add a step and press Enter" IsHitTestVisible="False" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=NewStepTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="1" Style="{StaticResource ModernButton}" Click="AddNewStep_Click" Padding="10,5" ToolTip="Add step (Enter)" AutomationProperties.Name="Add step">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"/>
                                        </Button>
                                    </Grid>
                                <ListView x:Name="StepsListView" Margin="0,0,0,4" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  AllowDrop="True" PreviewMouseLeftButtonDown="StepsListView_PreviewMouseLeftButtonDown" MouseMove="StepsListView_MouseMove" DragEnter="StepsListView_DragEnter" Drop="StepsListView_Drop">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0,4"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="4">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Border Grid.Column="0" Background="Transparent" Cursor="SizeAll" VerticalAlignment="Center" Margin="2,0,4,0">
                                            <TextBlock Text="&#x22EE;&#x22EE;" 
                                                       Foreground="{DynamicResource TextMuted}" FontSize="14" ToolTip="Drag to reorder"/>
                                        </Border>
                                                   
                                        <CheckBox x:Name="StepCheckBox" Grid.Column="1" IsChecked="{Binding IsDone}" VerticalAlignment="Center" Margin="0,0,6,0" Click="StepCheckBox_Click"/>
                                        
                                        <TextBox x:Name="StepTextBox" Grid.Column="2" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="28" Padding="4,2" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,10,0" MaxLength="100"/>
                                                 
                                        <Button Grid.Column="3" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                                                Style="{StaticResource DangerButton}" BorderThickness="0" Background="Transparent" 
                                                Padding="4" Margin="4,0,0,0" ToolTip="Remove Step" Click="RemoveStepButton_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                                    <TextBlock x:Name="StepsErrorText" Text="Step text field can not be empty." Foreground="{DynamicResource DangerColor}" FontSize="12" Margin="0,5,0,0" Visibility="Collapsed"/>
                                </StackPanel>

                                <!-- 3. Planning (moves to the right column in the full-width layout) -->
                                <StackPanel x:Name="PlanningSection" Margin="0,16,0,0">
                                    <TextBlock Text="Ticket number" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,18">
                                        <TextBox x:Name="VstsTextBox" MaxLength="50" AutomationProperties.Name="Ticket number" ToolTip="Leave empty to use the automatic number"/>
                                        <TextBlock x:Name="VstsPlaceholder" IsHitTestVisible="False" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=VstsTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Existing tasks: State -->
                                        <StackPanel x:Name="StatePanel" Grid.Column="0">
                                            <TextBlock Text="State" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <ComboBox x:Name="StateComboBox" Padding="8">
                                                <ComboBoxItem Tag="To Do">
                                                    <Border CornerRadius="12" Padding="8,4" Background="{DynamicResource ControlHover}" HorizontalAlignment="Left">
                                                        <TextBlock Text="To Do" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                                    </Border>
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="In progress">
                                                    <Border CornerRadius="12" Padding="8,4" Background="{DynamicResource WarningBackground}" HorizontalAlignment="Left">
                                                        <TextBlock Text="In progress" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarningColor}"/>
                                                    </Border>
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="Done">
                                                    <Border CornerRadius="12" Padding="8,4" Background="{DynamicResource SuccessBackground}" HorizontalAlignment="Left">
                                                        <TextBlock Text="Done" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessColor}"/>
                                                    </Border>
                                                </ComboBoxItem>
                                            </ComboBox>
                                        </StackPanel>
                                        <!-- New tasks: Start now -->
                                        <StackPanel x:Name="StartNowPanel" Grid.Column="0" Visibility="Collapsed">
                                            <TextBlock Text="Start now" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox x:Name="StartNowToggle" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" AutomationProperties.Name="Start now"
                                                          ToolTip="On: the task becomes active (In progress) and shows on the widget. Off: it waits as To Do."/>
                                                <TextBlock x:Name="StartNowHint" Text="To Do" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Existing tasks: Priority -->
                                        <StackPanel x:Name="PriorityPanel" Grid.Column="2">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Priority" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="5,0,0,0" ToolTip="Drag the task in the list to change its priority." Cursor="Help"/>
                                            </StackPanel>
                                            <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="10,8" ToolTip="Drag the task in the list to change its priority">
                                                <TextBlock x:Name="PriorityText" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <!-- New tasks: where to put it in the list -->
                                        <StackPanel x:Name="PositionPanel" Grid.Column="2" Visibility="Collapsed">
                                            <TextBlock Text="Add to" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="1" CornerRadius="6" Padding="2" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="PositionTopRadio" GroupName="NewTaskPosition" Content="Top" Style="{StaticResource SegmentRadio}" ToolTip="Highest priority (#1)" AutomationProperties.Name="Add to top of list"/>
                                                    <RadioButton x:Name="PositionBottomRadio" GroupName="NewTaskPosition" Content="Bottom" Style="{StaticResource SegmentRadio}" IsChecked="True" ToolTip="Lowest priority" AutomationProperties.Name="Add to bottom of list"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Due date" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Button x:Name="DueDateButton" Style="{StaticResource ModernButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" Click="DueDateButton_Click" AutomationProperties.Name="Pick due date">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="DueDateText" Text="No due date" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- Invisible picker that provides the calendar popup -->
                                        <DatePicker x:Name="TargetDatePicker" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="1" SelectedDateChanged="TargetDatePicker_SelectedDateChanged"/>
                                    </Grid>
                                    <WrapPanel Margin="0,0,0,2">
                                        <Button Content="Today" Style="{StaticResource ChipButton}" Click="DueToday_Click"/>
                                        <Button Content="Tomorrow" Style="{StaticResource ChipButton}" Click="DueTomorrow_Click"/>
                                        <Button Content="Next week" Style="{StaticResource ChipButton}" Click="DueNextWeek_Click" ToolTip="Monday next week"/>
                                        <Button x:Name="DueClearChip" Content="Clear" Style="{StaticResource ChipButton}" Click="DueClear_Click" Visibility="Collapsed"/>
                                    </WrapPanel>
                                    <Button x:Name="AddTimeButton" Content="+ Add a time" Style="{StaticResource ModernButton}" Background="Transparent" Foreground="{DynamicResource PrimaryBackground}" HorizontalAlignment="Left" Padding="4,2" Margin="0,0,0,12" Click="AddTime_Click" Visibility="Collapsed"
                                            ToolTip="Without a time, the task is due all day"/>
                                    <StackPanel x:Name="TimePanel" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                                        <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="TimeComboBox" Width="100" MaxDropDownHeight="260" AutomationProperties.Name="Due time"/>
                                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Style="{StaticResource ModernButton}" Background="Transparent" Padding="8,6" Margin="4,0,0,0" Click="RemoveTime_Click" ToolTip="Remove time (due all day)" AutomationProperties.Name="Remove time"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 4. Notes -->
                                <StackPanel x:Name="NotesSection" Margin="0,16,0,0">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Description" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding ElementName=DescriptionTextBox, Path=Text.Length, StringFormat={}{0}/2000}" Visibility="{Binding ElementName=DescriptionTextBox, Path=Text.Length, Converter={StaticResource NearLimitVis}, ConverterParameter=2000}" Foreground="{DynamicResource TextMuted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <TextBox x:Name="DescriptionTextBox" Margin="0,0,0,18" MinHeight="60" MaxHeight="300" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MaxLength="2000" AutomationProperties.Name="Description"/>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Acceptance criteria (AC)" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding ElementName=AcTextBox, Path=Text.Length, StringFormat={}{0}/2000}" Visibility="{Binding ElementName=AcTextBox, Path=Text.Length, Converter={StaticResource NearLimitVis}, ConverterParameter=2000}" Foreground="{DynamicResource TextMuted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <TextBox x:Name="AcTextBox" Margin="0,0,0,18" MinHeight="60" MaxHeight="300" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MaxLength="2000" AutomationProperties.Name="Acceptance criteria"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="RightColumnStack" Grid.Column="1" Margin="30,0,0,0" Visibility="Collapsed"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Pinned Bottom Buttons -->
            <StackPanel x:Name="ButtonPanel" Grid.Row="1" Grid.Column="2" Margin="30,0,30,20" Visibility="Collapsed">
                <!-- Shown when leaving a form that has unsaved edits -->
                <Border x:Name="UnsavedBar" Visibility="Collapsed" Style="{StaticResource InfoBarWarning}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource WarningColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="You have unsaved changes." Style="{StaticResource BodyStrongText}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Keep editing" Style="{StaticResource SubtleButton}" Margin="0,0,8,0" Click="UnsavedKeepEditing_Click"/>
                            <Button Content="Discard" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="UnsavedDiscard_Click"/>
                            <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="UnsavedSave_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Grid>
                    <Button x:Name="DeleteTaskButton" Content="Delete" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Click="DeleteButton_Click" ToolTip="Delete task (Del) — you can undo"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource ModernButton}" Margin="0,0,8,0" Click="CancelButton_Click" ToolTip="Close without saving (Esc)"/>
                        <Button x:Name="SaveAndNewButton" Content="Save &amp; new" Style="{StaticResource ModernButton}" Margin="0,0,8,0" Click="SaveAndNew_Click" ToolTip="Save and start another task (Ctrl+Enter)"/>
                        <Button Content="Save task" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" ToolTip="Save (Ctrl+S)"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid> <!-- Close TasksTabContent -->
                <Grid x:Name="AboutTabContent" Visibility="Collapsed" Margin="40">
                    <StackPanel>
                        <TextBlock Text="About" Style="{StaticResource TitleText}" Margin="0,0,0,20"/>
                        <TextBlock Text="Task And Ticket Tracker is a lightweight, context-aware productivity tool designed to help you stay focused on what matters." Foreground="{DynamicResource TextHighlight}" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="14"/>
                        <TextBlock Text="Version: 1.5.0.0" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,20"/>
                        
                        <TextBlock Text="What it does" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        <TextBlock Text="• Capture tasks in seconds with Quick add, steps and due-date shortcuts" Foreground="{DynamicResource TextHighlight}" Margin="10,0,0,6" TextWrapping="Wrap"/>
                        <TextBlock Text="• Focus on one or two active tasks at a time, in priority order" Foreground="{DynamicResource TextHighlight}" Margin="10,0,0,6" TextWrapping="Wrap"/>
                        <TextBlock Text="• Keep your current step in view with a floating, edge-docked or taskbar widget" Foreground="{DynamicResource TextHighlight}" Margin="10,0,0,6" TextWrapping="Wrap"/>
                        <TextBlock Text="• Due-date reminders that hide task details during Do Not Disturb" Foreground="{DynamicResource TextHighlight}" Margin="10,0,0,6" TextWrapping="Wrap"/>
                        <TextBlock Text="• Everything stays on this device, with automatic backups" Foreground="{DynamicResource TextHighlight}" Margin="10,0,0,20" TextWrapping="Wrap"/>

                        <Button Width="200" Height="36" HorizontalAlignment="Left" Margin="0,0,0,20" Style="{StaticResource PrimaryButton}" Click="ViewDocs_Click" ToolTip="Open the user guide (F1)" AutomationProperties.Name="Open user guide">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE897;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Open user guide" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,10,0,0">
                            All data stays on this device.
                            <Hyperlink NavigateUri="https://github.com/tanmayprasad/Task-And-Ticket-Tracker/blob/main/PRIVACY.md" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource PrimaryBackground}">Privacy Policy</Hyperlink>
                        </TextBlock>
                        <TextBlock Text="© 2026 Tanmay Prasad. All rights reserved." Foreground="{DynamicResource TextDark}" FontSize="12" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            
            <!-- Settings Tab Content: Windows 11 Settings-style rows; every change applies instantly -->
            <Grid x:Name="SettingsTabContent" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,28,36,36" MaxWidth="1000">
                    <TextBlock Text="Settings" Style="{StaticResource TitleText}" Margin="0,0,0,24"/>

                    <TextBlock Text="Focus" Style="{StaticResource BodyStrongText}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7C1;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0,20,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Active tasks at a time" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="How many tasks you can focus on at once. Active tasks show on the widget." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <ComboBox x:Name="MaxActiveTasksComboBox" Width="96" SelectionChanged="MaxActiveTasksComboBox_SelectionChanged" AutomationProperties.Name="Active tasks at a time">
                                    <ComboBoxItem Content="1" Tag="1"/><ComboBoxItem Content="2" Tag="2"/><ComboBoxItem Content="3" Tag="3"/><ComboBoxItem Content="4" Tag="4"/><ComboBoxItem Content="5" Tag="5"/>
                                    <ComboBoxItem Content="6" Tag="6"/><ComboBoxItem Content="7" Tag="7"/><ComboBoxItem Content="8" Tag="8"/><ComboBoxItem Content="9" Tag="9"/><ComboBoxItem Content="10" Tag="10"/>
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Text="Reminders" Style="{StaticResource BodyStrongText}" Margin="0,20,0,8"/>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0,20,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Due-date reminders" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Get a reminder before a task is due. Task details are hidden while Do Not Disturb is on." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <CheckBox x:Name="NotificationsToggle" Style="{StaticResource ToggleSwitchStyle}" Click="NotificationsToggle_Click" AutomationProperties.Name="Due-date reminders"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0,20,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Remind me" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="How long before the due date the reminder appears." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <ComboBox x:Name="AlertTimerComboBox" Width="150" SelectionChanged="AlertTimerComboBox_SelectionChanged" AutomationProperties.Name="Remind me"
                                          IsEnabled="{Binding IsChecked, ElementName=NotificationsToggle}">
                                    <ComboBoxItem Content="At the due time" Tag="0"/>
                                    <ComboBoxItem Content="30 minutes before" Tag="0.5"/>
                                    <ComboBoxItem Content="1 hour before" Tag="1"/>
                                    <ComboBoxItem Content="2 hours before" Tag="2"/>
                                    <ComboBoxItem Content="4 hours before" Tag="4"/>
                                    <ComboBoxItem Content="8 hours before" Tag="8"/>
                                    <ComboBoxItem Content="12 hours before" Tag="12"/>
                                    <ComboBoxItem Content="1 day before" Tag="24"/>
                                    <ComboBoxItem Content="2 days before" Tag="48"/>
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Text="Appearance" Style="{StaticResource BodyStrongText}" Margin="0,20,0,8"/>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0,20,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="App theme" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Use your Windows setting, or always dark or light." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <ComboBox x:Name="ThemeComboBox" Width="170" SelectionChanged="ThemeComboBox_SelectionChanged" AutomationProperties.Name="App theme">
                                    <ComboBoxItem Content="Use system setting" Tag="System"/>
                                    <ComboBoxItem Content="Dark" Tag="Dark"/>
                                    <ComboBoxItem Content="Light" Tag="Light"/>
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE771;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0,20,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Accent colour" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Follows your Windows accent colour (Settings → Personalization → Colors)." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource PrimaryBackground}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
                                        ToolTip="Current accent colour"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Text="Desktop widget" Style="{StaticResource BodyStrongText}" Margin="0,20,0,8"/>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0,20,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Widget style" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                            <Setter Property="Text" Value="A movable card that stays on top of other windows."/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem.Tag, ElementName=WidgetModeComboBox}" Value="EdgeDocked">
                                                    <Setter Property="Text" Value="Hides as a thin tab on a screen edge and slides out when you hover over it."/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedItem.Tag, ElementName=WidgetModeComboBox}" Value="TaskbarStrip">
                                                    <Setter Property="Text" Value="Shows '#ticket · current step' on the taskbar next to the clock (experimental)."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <ComboBox x:Name="WidgetModeComboBox" Width="210" SelectionChanged="WidgetModeComboBox_SelectionChanged" AutomationProperties.Name="Widget style">
                                    <ComboBoxItem Content="Floating" Tag="Floating"/>
                                    <ComboBoxItem Content="Edge-docked (auto-hide)" Tag="EdgeDocked"/>
                                    <ComboBoxItem Content="Taskbar strip" Tag="TaskbarStrip"/>
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0,20,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Widget theme" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Colours of the widget and taskbar strip." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <ComboBox x:Name="WidgetThemeComboBox" Width="120" SelectionChanged="WidgetThemeComboBox_SelectionChanged" AutomationProperties.Name="Widget theme">
                                    <ComboBoxItem Content="Dark" Tag="Dark"/>
                                    <ComboBoxItem Content="Light" Tag="Light"/>
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8D2;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0,20,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Text size" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Size of the task title on the widget." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Value, ElementName=WidgetTextSizeSlider, StringFormat={}{0:0} pt}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Width="44" TextAlignment="Right" Margin="0,0,12,0"/>
                                    <Slider x:Name="WidgetTextSizeSlider" Width="200" Minimum="12" Maximum="36" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1"
                                            ValueChanged="WidgetSlider_ValueChanged" PreviewMouseLeftButtonUp="WidgetSlider_MouseUp" AutomationProperties.Name="Widget text size"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8DD;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0,20,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Bold text" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Use a bold weight for the widget title." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <CheckBox x:Name="WidgetTextBoldToggle" Style="{StaticResource ToggleSwitchStyle}" Click="WidgetTextBoldToggle_Click" AutomationProperties.Name="Bold widget text"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE9A9;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0,20,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Background opacity" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="How see-through the widget background is." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Value, ElementName=WidgetOpacitySlider, StringFormat={}{0:P0}}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Width="44" TextAlignment="Right" Margin="0,0,12,0"/>
                                    <Slider x:Name="WidgetOpacitySlider" Width="200" Minimum="0.4" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" IsSnapToTickEnabled="True" TickFrequency="0.05"
                                            ValueChanged="WidgetSlider_ValueChanged" PreviewMouseLeftButtonUp="WidgetSlider_MouseUp" AutomationProperties.Name="Widget background opacity"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Text="Changes are saved automatically." Style="{StaticResource CaptionText}" Margin="4,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
            </Border>
        </Grid>

        <!-- Notification bar (snackbar): short confirmations with an optional action such as Undo -->
        <Border x:Name="Snackbar" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                Style="{StaticResource InfoBarNeutral}" MaxWidth="620">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="4" Direction="270" BlurRadius="18" Opacity="0.26"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="SnackbarText" Foreground="{DynamicResource TextPrimary}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
                <Button x:Name="SnackbarActionButton" Style="{StaticResource StandardButton}" FontWeight="SemiBold" Margin="16,0,0,0" Visibility="Collapsed" Click="SnackbarAction_Click"/>
                <Button Content="&#xE711;" Style="{StaticResource IconButton}" FontSize="11" Margin="4,0,0,0"
                        Click="SnackbarClose_Click" ToolTip="Dismiss" AutomationProperties.Name="Dismiss notification"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
